{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-core",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "ui-essentials",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/app-icons/**/*.png",
          "/img/logo-ibfc*.+(png|jpg)",
          "/**/*.svg",
          "/**/*.woff2",
          "/**/*.woff",
          "/**/*.ttf"
        ]
      }
    },
    {
      "name": "heavy-images",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/**/*.+(jpg|jpeg|png|apng|webp|avif|gif)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "google-fonts-and-material-icons",
      "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "365d",
        "strategy": "performance"
      }
    }
  ]
}
